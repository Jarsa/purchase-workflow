<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="purchase_line_sale_history.SalesHistoryField">
        <div
            t-if="this.historyData"
            t-attf-class="o_purchase_sales_history #{this.state.collapsed ? 'o_purchase_sales_history_collapsed' : ''}"
        >
            <button
                type="button"
                class="o_purchase_sales_history_header"
                t-on-click="this.toggleCollapse"
                t-att-aria-expanded="!this.state.collapsed ? 'true' : 'false'"
            >
                <span class="o_purchase_sales_history_header_text">
                    <span class="text-muted small text-uppercase">
                        Sales History
                    </span>
                    <strong t-out="this.historyData.product_name" />
                </span>
                <i
                    class="oi o_purchase_sales_history_toggle_icon"
                    t-att-data-icon="this.state.collapsed ? 'keyboard_arrow_up' : 'keyboard_arrow_down'"
                    role="img"
                />
            </button>
            <div
                class="o_purchase_sales_history_scroll"
                t-if="!this.state.collapsed"
            >
                <table class="table table-sm o_purchase_sales_history_table">
                    <thead>
                        <tr>
                            <th class="o_purchase_sales_history_sticky_col">Year</th>
                            <t t-foreach="this.months" t-as="month" t-key="month_index">
                                <th
                                    t-attf-class="text-end #{month_index === this.currentMonthIndex ? 'o_purchase_sales_history_current_month' : ''}"
                                    t-out="month"
                                />
                            </t>
                            <th
                                class="text-end o_purchase_sales_history_total"
                            >Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="this.years" t-as="year" t-key="year">
                            <tr>
                                <td class="o_purchase_sales_history_sticky_col">
                                    <t t-out="year" />
                                </td>
                                <t t-foreach="this.months" t-as="month" t-key="month_index">
                                    <td class="text-end">
                                        <t
                                            t-set="value"
                                            t-value="this.valueFor(year, month_index)"
                                        />
                                        <span
                                            t-if="value === null"
                                            class="text-muted"
                                        >—</span>
                                        <span
                                            t-else=""
                                            class="o_purchase_sales_history_cell"
                                            t-attf-style="#{this.cellStyle(year, month_index)}"
                                            t-out="value"
                                        />
                                    </td>
                                </t>
                                <td
                                    class="text-end fw-bold o_purchase_sales_history_total"
                                >
                                    <t t-out="this.rowTotal(year)" />
                                </td>
                            </tr>
                        </t>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="o_purchase_sales_history_sticky_col text-muted">
                                Total
                            </td>
                            <t t-foreach="this.months" t-as="month" t-key="month_index">
                                <td
                                    class="text-end text-muted"
                                    t-out="this.colTotal(month_index)"
                                />
                            </t>
                            <td
                                class="text-end fw-bold o_purchase_sales_history_total"
                                t-out="this.grandTotal"
                            />
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="text-muted small fst-italic" t-else="">
            Check the Sales History box on a line to see its product's sales history.
        </div>
    </t>

</templates>
